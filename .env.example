# Stripe (https://dashboard.stripe.com/apikeys). Use sk_test_... until you're ready to go live.
STRIPE_SECRET_KEY=

# Charge Texas sales tax with Stripe Tax (turn on Stripe Tax in the dashboard first).
STRIPE_AUTOMATIC_TAX=false

# Public URL of the site, used for Stripe's return links. Optional locally.
SITE_URL=http://localhost:3000

# Quote requests are emailed to contact.email in catalog/store.yaml through Resend (https://resend.com).
RESEND_API_KEY=
# A sender on a domain you've verified in Resend, e.g. "Quotes <quotes@yourdomain.com>"
RESEND_FROM=

# Show draft products on a production deployment (e.g. a preview site). Drafts always show in `npm run dev`.
SHOW_DRAFTS=false
