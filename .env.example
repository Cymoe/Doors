# Your store's myshopify domain (not the custom domain)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2025-10

# Option A: an Admin API access token (shpat_...) from a custom app
SHOPIFY_ADMIN_TOKEN=

# Option B: a Dev Dashboard app installed on your own store (client credentials grant)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
